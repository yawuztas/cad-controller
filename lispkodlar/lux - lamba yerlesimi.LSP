; Komut Adi : LUX
;
; Elektrik projelerinde verilen bir alana gerekli luxte isik icin kac lamba 
; gerektigini hesaplayan ve yerlestiren bir programdir. Daha onceden yazdigim 
; LAMP.LSP programinin daha gelistirilmis bir versiyonudur. 
; Lamba tipleri sadece fluoresan ve spot tipi olup hesap degerleri ve blok
; adlari sabittir. Istenilen degerler sadece gerekli isik siddeti ve armatur
; verimliligi degerleridir. Bunlara karsilik gelen lamba sayisi hesaplanip
; ekrana bastirildiktan sonra kac lamba koyulacagi LAMP fonksiyonu gibi 
; calisir. 
;
; Ozgur Ulupinar , Yurdakul Elektrik Ltd.
; 08.01.1995 Ankara 
; (c)1995 by U2 Software
;
(defun c:lux () 
(setvar "cmdecho" 0)
(graphscr)
(prompt "\nLUX by U2")
(if (= lx nil) (setq lx 0))
(if (= tip nil) (setq tip ""))
(setq p1(getpoint "\nsað alt köþe : "))
(setq p2(getcorner p1 "\nsol üst köþe  : "))
(setq uz1(- (car p2) (car p1)))
(setq uz2(- (cadr p2) (cadr p1)))
(setq yaz (strcat "< " (itoa lx) " > : "))
(setq lux (getint (strcat "\nLUX " yaz)))  
(if (= lux nil) (setq lux lx)) 
(setq lx lux)

(setq typ (getstring (strcat "\narmatür tipi < " tip " > : ")))
(if (or (= typ nil) (= typ "")) (setq typ tip))
(cond ((= typ "418") (setq flux 5000)) 
      ((= typ "236") (setq flux 6700))
      ((= typ "136") (setq flux 2500))
      ((= typ "218") (setq flux 2500))
      ((= typ "118") (setq flux 1250))
      ((or (= typ "A100") (= typ "a100")) (setq flux 1380))
      ((or (= typ "A75") (= typ "a75") (= typ "H50") (= typ "h50")) (setq flux 960))
      ((or (= typ "A40") (= typ "a40") (= typ "H20") (= typ "h20")) (setq flux 430))
      ((or (= typ "A60") (= typ "a60")) (setq flux 730))
      ((or (= typ "A26") (= typ "a26")) (setq flux 1800))
      (      T       (fixhelp))
)
(cond ((= typ "418") (setq insn "4x18")) 
      ((= typ "236") (setq insn "2x36"))
      ((= typ "136") (setq insn "1x36"))
      ((= typ "218") (setq insn "2x18"))
      ((= typ "118") (setq insn "2x18"))
      ((or (= typ "A100") (= typ "a100") (= typ "A75") (= typ "a75") (= typ "H50") (= typ "h50") (= typ "A40") (= typ "a40") (= typ "H20") (= typ "h20") (= typ "A60") (= typ "a60") (= typ "A26") (= typ "a26")) (setq insn "sp"))
      (      T       (exit))
)
(setq tip typ)
(setq lam (getint "\nLamp efficiency < 30 > :"))
(if (= lam nil) (setq lam 30)) 
(setq eff (/ lam 100.0))
(setq no (/ (* uz1 uz2 lux) (* flux eff)))
(princ (strcat "\nThe number of lamps needed ==> " (rtos no 2 2)))

(setq row(getint "\ndikeyde kaç sýra    --- < 1 > : "))
(if (= row nil) (setq row 1))
(setq col(getint "\nyatayda kaç sýra ³³³ < 1 > : "))
(if (= col nil) (setq col 1))
(setq ara1(/ uz1 (* 2 col))) 
(setq ara2(/ uz2 (* 2 row)))
(setq p3(list (+ ara1 (car p1)) (+ ara2 (cadr p1))))
(setq blok(getstring (strcat "\nBlock name < " insn " > : ")))
(if (or (= blok nil) (= blok "")) (setq blok insn))
(command "insert" blok p3 "1" "1" )
(prompt "\nRotation angle : ")
(command pause)
(setq obje (entlast))
(setq ara3 (* 2 ara1))
(setq ara4 (* 2 ara2))
(if (= col 1) 
          (command "array" obje "" "R" row col ara4 ))
(if (= row 1)
          (command "array" obje "" "r" row col ara3 ))
(if (and (/= row 1) (/= col 1)) 
          (command "array" obje "" "r" row col ara4 ara3 ))
(princ)
)

(defun fixhelp()
(textscr)
(princ "\nLamp Types available ==>")
(princ "\n                          4x18W     =  418        1x36W    =  136")
(princ "\n                          2x36W     =  236        2x18W    =  218")
(princ "\n                          1x18W     =  118                       ")
(princ "\n                          Spot 100W =  A100       Spot 75W =  A75")
(princ "\n                          Spot 60W  =  A60        Spot 40W =  A40")
(princ "\n                          Spot 26W  =  A26")
(princ "\n                          Hal  50W  =  H50        Hal  25W =  H25") 
(setq typ (getstring "\nFixture type :"))
(cond ((= typ "418") (setq flux 5000)) 
      ((= typ "236") (setq flux 6700))
      ((= typ "136") (setq flux 2500))
      ((= typ "218") (setq flux 2500))
      ((= typ "118") (setq flux 1250))
      ((or (= typ "A100") (= typ "a100")) (setq flux 1380))
      ((or (= typ "A75") (= typ "a75") (= typ "H50") (= typ "h50")) (setq flux 960))
      ((or (= typ "A40") (= typ "a40") (= typ "H20") (= typ "h20")) (setq flux 430))
      ((or (= typ "A60") (= typ "a60")) (setq flux 730))
      ((or (= typ "A26") (= typ "a26")) (setq flux 1800))
      (      T       (exit))
)
(graphscr)
)
(princ "\n\tc:LUX loaded.  Start command with LUX.")
(princ)